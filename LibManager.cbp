<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="LibManager" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/LibManager" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/LibManager" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Unit filename="book.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="book.h" />
		<Unit filename="date.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="date.h" />
		<Unit filename="library.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="library.h" />
		<Unit filename="main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="str_manip.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="str_manip.h" />
		<Unit filename="subcriber.c">
			<Option compilerVar="CC" />
		</Unit>
